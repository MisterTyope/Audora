{
  "manifest_version": 3,
  "name": "Audora - Bouton rapide",
  "version": "1.2",
  "description": "Ajoute des boutons Telecharger MP4/MP3 sur les pages YouTube, relies a l'application Audora installee sur ce PC.",
  "host_permissions": [
    "http://127.0.0.1:47935/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
